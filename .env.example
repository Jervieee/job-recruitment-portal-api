# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/job_recruitment_portal

# JWT Configuration
JWT_SECRET=change_this_to_a_strong_random_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# CORS & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# File Uploads
MAX_RESUME_SIZE_MB=5
